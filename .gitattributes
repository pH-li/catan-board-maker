# Normalize line endings so Windows, macOS and Linux contributors produce identical files.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.stl binary
*.3mf binary
*.glb binary
*.zip binary
*.wasm binary
*.woff binary
*.woff2 binary
